{
  "name": "samayam",
  "productName": "Samayam",
  "version": "1.5.0",
  "description": "Samayam (സമയം) - an accessible school timetable generator and substitution manager for Kerala schools (LP, UP, HS, HSS). Works with NVDA, JAWS and Narrator.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node test/test.js",
    "dist": "electron-builder --win --publish never",
    "release": "node scripts/release.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hamsajaisal/samayam.git"
  },
  "keywords": [
    "timetable",
    "school",
    "substitution",
    "kerala",
    "accessibility",
    "nvda",
    "electron"
  ],
  "license": "MIT",
  "build": {
    "appId": "org.samayam.timetable",
    "productName": "Samayam",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "docs/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hamsajaisal",
        "repo": "samayam"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Samayam",
      "artifactName": "Samayam-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Samayam-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
